pkgname=scenes
pkgver=0.1.0
pkgrel=3
pkgdesc='Save and restore named setups of the Omarchy desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hyprland' 'omarchy' 'gtk3' 'uwsm')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/scenes "$pkgdir/usr/bin/scenes"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/scenes.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/scenes.svg"
  install -Dm644 "$startdir/scenes.desktop" "$pkgdir/usr/share/applications/scenes.desktop"
}
